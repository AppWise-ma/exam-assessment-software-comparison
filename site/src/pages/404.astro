---
import Base from "../layouts/Base.astro";
import { url } from "../lib/data.ts";
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="py-20 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 muted">This page does not exist.</p>
    <a href={url()} class="btn btn-primary mt-6">Go to the directory</a>
  </div>
</Base>

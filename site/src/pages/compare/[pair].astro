---
// One page per pair that includes Next Exams, e.g. /compare/next-exams-vs-moodle/.
// No pages are emitted until data/products/next-exams.yaml exists.
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import ComparisonApp from "../../components/ComparisonApp.astro";
import { absUrl, areas, bySlug, features, products, url, verdicts } from "../../lib/data.ts";
import type { Product } from "../../../../scripts/lib/data.ts";
import { compareStats, comparePairs, lastVerified, softwareApplicationLd } from "../../../../scripts/lib/site.ts";

export const getStaticPaths = (() =>
  comparePairs(products.map((p) => p.slug)).map(({ pair, a, b }) => ({
    params: { pair },
    props: { a: bySlug.get(a)!, b: bySlug.get(b)! },
  }))) satisfies GetStaticPaths;

const { a, b } = Astro.props as { a: Product; b: Product };
const path = `compare/${a.slug}-vs-${b.slug}/`;
const { both, differ } = compareStats(a, b, [...features.keys()]);
const title = `${a.name} vs ${b.name}: exam software comparison`;
const description = `${a.name} vs ${b.name} on ${features.size} exam features. Both checked on ${both}; they differ on ${differ}. Each value links to its source.`;
const areaLabel = new Map(areas.map((x) => [x.id, x.label]));
const relevant = verdicts.filter((v) => [a.slug, b.slug].some((s) => v.winners.includes(s) || v.runner_up === s));

const itemList = {
  "@type": "ItemList",
  name: `${a.name} vs ${b.name}`,
  numberOfItems: 2,
  itemListElement: [a, b].map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: absUrl(`products/${p.slug}/`),
    item: softwareApplicationLd(p, absUrl(`products/${p.slug}/`)),
  })),
};
---
<Base
  title={title}
  description={description}
  breadcrumbs={[{ name: `${a.name} vs ${b.name}`, path }]}
  ld={[itemList]}
  modified={lastVerified([a, b])}
  wide
>
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">{a.name} vs {b.name}</h1>
  <p class="mt-3 max-w-3xl text-sm leading-6 text-zinc-600 dark:text-zinc-400">
    <a href={url(`products/${a.slug}/`)}>{a.name}</a> and <a href={url(`products/${b.slug}/`)}>{b.name}</a> are checked
    against the same {features.size} feature definitions. Click a value to open its source.
  </p>
  <dl class="my-6 grid max-w-2xl grid-cols-3 gap-px overflow-hidden rounded-xl border border-zinc-200 bg-zinc-200 text-sm dark:border-zinc-800 dark:bg-zinc-800">
    <div class="bg-white p-4 dark:bg-zinc-950"><dt class="eyebrow">Features</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{features.size}</dd></div>
    <div class="bg-white p-4 dark:bg-zinc-950"><dt class="eyebrow">Both checked</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{both}</dd></div>
    <div class="bg-white p-4 dark:bg-zinc-950"><dt class="eyebrow">Differ</dt><dd class="mt-1 text-2xl font-semibold tabular-nums">{differ}</dd></div>
  </dl>
  {relevant.length > 0 && (
    <section aria-labelledby="verdicts" class="mb-8">
      <h2 id="verdicts" class="mb-3 text-lg font-semibold">Area verdicts</h2>
      <ul class="space-y-2 text-sm">
        {relevant.map((v) => (
          <li>
            <strong>{areaLabel.get(v.area) ?? v.area}:</strong>{" "}
            {v.winners.map((w) => bySlug.get(w)?.name ?? w).join(", ") || "No clear winner"}. {v.rationale}
          </li>
        ))}
      </ul>
    </section>
  )}
  <ComparisonApp products={[a, b]} />
</Base>

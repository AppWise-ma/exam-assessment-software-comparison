---
import Base from "../layouts/Base.astro";
import AreaTable from "../components/AreaTable.astro";
import ProductsTable from "../components/ProductsTable.astro";
import { absUrl, areas, bySlug, products, url, verdicts } from "../lib/data.ts";
import { softwareApplicationLd } from "../../../scripts/lib/site.ts";

const names = products.map((p) => p.name);
const title = products.length
  ? `Open-source exam software compared: ${products.length} products, every value sourced`
  : "Open-source exam software comparison";
const description = products.length
  ? `Feature-by-feature comparison of ${names.join(", ")}. Each value links to its source and shows when it was checked.`
  : "A sourced comparison of open-source exam, quiz and assessment software.";

const itemList = {
  "@type": "ItemList",
  name: "Open-source exam software",
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: absUrl(`products/${p.slug}/`),
    item: softwareApplicationLd(p, absUrl(`products/${p.slug}/`)),
  })),
};
const areaLabel = new Map(areas.map((a) => [a.id, a.label]));
---
<Base title={title} description={description} ld={[itemList]}>
  <h1>Open-source exam software comparison</h1>
  <p class="lead">
    Exam, quiz and assessment software with an open-source license, compared on the same list of features.
    Each value links to the page, changelog or source file that shows it. Hover a value to see the date it was checked.
    "Not checked" means we have not confirmed it yet. Read <a href={url("methodology/")}>how values are collected</a>.
  </p>

  {products.length === 0 ? (
    <p>No products published yet.</p>
  ) : (
    <>
      <h2 id="products">Products</h2>
      <ProductsTable products={products} />

      <h2 id="verdicts">Best in each area</h2>
      {verdicts.length === 0 ? (
        <p class="muted">Verdicts are published after hands-on testing is complete.</p>
      ) : (
        <ul>
          {verdicts.map((v) => (
            <li>
              <strong>{areaLabel.get(v.area) ?? v.area}:</strong>{" "}
              {v.winners.map((w) => bySlug.get(w)?.name ?? w).join(", ") || "No clear winner"}. {v.rationale}
            </li>
          ))}
        </ul>
      )}

      {areas.map((area) => <AreaTable area={area} products={products} idPrefix="home" />)}
    </>
  )}
</Base>

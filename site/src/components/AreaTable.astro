---
import type { Area, Product } from "../../../scripts/lib/data.ts";
import { isAssessed } from "../../../scripts/lib/site.ts";
import { url } from "../lib/data.ts";
import CellValue from "./CellValue.astro";

interface Props {
  area: Area;
  products: Product[];
  /** Makes footnote ids unique when several tables share a page. */
  idPrefix?: string;
  headingLevel?: 2 | 3;
}

const { area, products, idPrefix = "t", headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}`;

// Number the notes of this table in reading order (row by row).
const notes: { id: string; n: number; product: string; feature: string; text: string }[] = [];
const noteFor = new Map<string, { id: string; n: number }>();
for (const f of area.features) {
  for (const p of products) {
    const cell = p.features[`${area.id}.${f.id}`];
    if (isAssessed(cell) && cell.note) {
      const n = notes.length + 1;
      const id = `${idPrefix}-${area.id}-n${n}`;
      notes.push({ id, n, product: p.name, feature: f.label, text: cell.note });
      noteFor.set(`${p.slug}|${f.id}`, { id, n });
    }
  }
}
---
<section aria-labelledby={`${idPrefix}-${area.id}`}>
  <Heading id={`${idPrefix}-${area.id}`}>{area.label}</Heading>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          {products.map((p) => (
            <th scope="col" class={p.affiliated ? "col-ours" : undefined}>
              <a href={url(`products/${p.slug}/`)}>{p.name}</a>
              {p.affiliated && <span class="badge badge-ours">ours</span>}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {area.features.map((f) => (
          <tr>
            <th scope="row" title={f.definition.trim()}>{f.label}</th>
            {products.map((p) => {
              const ref = noteFor.get(`${p.slug}|${f.id}`);
              return (
                <td class={p.affiliated ? "col-ours" : undefined}>
                  <CellValue cell={p.features[`${area.id}.${f.id}`]} noteId={ref?.id} noteNumber={ref?.n} />
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {notes.length > 0 && (
    <ol class="footnotes">
      {notes.map((n) => <li id={n.id} value={n.n}>{n.product}, {n.feature}: {n.text}</li>)}
    </ol>
  )}
</section>

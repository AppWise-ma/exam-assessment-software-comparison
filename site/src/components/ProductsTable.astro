---
import type { Product } from "../../../scripts/lib/data.ts";
import { PLATFORM_LABEL } from "../../../scripts/lib/site.ts";
import { productCoverage, url } from "../lib/data.ts";
import CellValue from "./CellValue.astro";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Product</th>
        <th scope="col">Platform</th>
        <th scope="col">License</th>
        <th scope="col">Price model</th>
        <th scope="col">Version checked</th>
        <th scope="col">Features checked</th>
      </tr>
    </thead>
    <tbody>
      {products.map((p) => {
        const { assessed, total } = productCoverage(p);
        return (
          <tr class={p.affiliated ? "col-ours" : undefined}>
            <th scope="row">
              <a href={url(`products/${p.slug}/`)}>{p.name}</a>
              {p.affiliated && <span class="badge badge-ours">ours</span>}
            </th>
            <td><a href={url(`platform/${p.platform}/`)}>{PLATFORM_LABEL[p.platform] ?? p.platform}</a></td>
            <td class="nowrap"><CellValue cell={p.features["cost.license_spdx"]} /></td>
            <td class="nowrap"><CellValue cell={p.features["cost.price_model"]} /></td>
            <td>{p.version_tested}</td>
            <td>{assessed} of {total}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

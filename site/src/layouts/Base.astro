---
import "../styles/global.css";
import { absUrl, bySlug, indexedPlatforms, products, url } from "../lib/data.ts";
import { PLATFORM_LABEL, REPO_URL, breadcrumbLd, comparePairs, jsonLd, metaDescription } from "../../../scripts/lib/site.ts";

interface Props {
  title: string;
  description: string;
  /** Trail after "Home". Each path is relative to the site base. */
  breadcrumbs?: { name: string; path: string }[];
  /** JSON-LD objects without @context. */
  ld?: Record<string, unknown>[];
  /** Full-width main area for the comparison table. */
  wide?: boolean;
  /** Most recent check date of the data on the page (YYYY-MM-DD). */
  modified?: string | null;
  /** Keep the page out of search results (thin or utility pages). */
  noindex?: boolean;
}

const SITE_NAME = "Open-source exam software comparison";
const GOOGLE_SITE_VERIFICATION = "f4gZjyYLjm4t89jumMFBt7VuAfwmxgWfsDpzKpwQT74";
const { title, description, breadcrumbs = [], ld = [], wide = false, modified = null, noindex = false } = Astro.props;
const metaDesc = metaDescription(description);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absUrl("og.png");
const trail = [{ name: "Home", path: "" }, ...breadcrumbs];
const webPage: Record<string, unknown> = {
  "@type": "WebPage",
  name: title,
  description: metaDesc,
  url: canonical,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: SITE_NAME, url: absUrl() },
};
if (modified) webPage.dateModified = modified;
const structured = [
  webPage,
  ...ld,
  ...(breadcrumbs.length ? [breadcrumbLd(trail.map((c) => ({ name: c.name, url: absUrl(c.path) })))] : []),
];
const path = Astro.url.pathname;
const nav = [
  { label: "Directory", href: url() },
  { label: "Compare", href: url("compare/") },
  { label: "Methodology", href: url("methodology/") },
];
const pairs = comparePairs(products.map((p) => p.slug));
const nameOf = (slug: string) => bySlug.get(slug)?.name ?? slug;
const container = wide ? "max-w-[100rem]" : "max-w-6xl";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Open-source exam software compared feature by feature, every value sourced" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Crect width=%2716%27 height=%2716%27 rx=%274%27 fill=%27%232459e0%27/%3E%3Cpath d=%27M4 8.5l2.5 2.5L12 5%27 stroke=%27white%27 stroke-width=%272%27 fill=%27none%27/%3E%3C/svg%3E" />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    {structured.map((item) => <script type="application/ld+json" set:html={jsonLd(item)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:shadow">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/85 backdrop-blur dark:border-zinc-800/80 dark:bg-zinc-950/85">
      <div class:list={["mx-auto flex h-14 items-center justify-between gap-4 px-4 sm:px-6", container]}>
        <a href={url()} aria-label={SITE_NAME} class="flex min-w-0 items-center gap-2 font-semibold text-zinc-900 no-underline dark:text-zinc-50">
          <svg class="size-6 shrink-0" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" rx="4" fill="#2459e0" /><path d="M4 8.5l2.5 2.5L12 5" stroke="white" stroke-width="2" fill="none" /></svg>
          <span class="hidden truncate sm:block">Open-source exam software<span class="hidden md:inline"> comparison</span></span>
        </a>
        <nav aria-label="Main">
          <ul class="flex items-center gap-1 text-sm">
            {nav.map((n) => {
              const active = n.href === url() ? path === url() : path.startsWith(n.href);
              return (
                <li>
                  <a
                    href={n.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "rounded-lg px-2.5 py-1.5 no-underline transition-colors sm:px-3",
                      active
                        ? "bg-zinc-100 font-medium text-zinc-900 dark:bg-zinc-800 dark:text-zinc-50"
                        : "text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
                    ]}
                  >{n.label}</a>
                </li>
              );
            })}
            <li class="hidden sm:block">
              <a href={REPO_URL} class="rounded-lg px-3 py-1.5 text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">GitHub</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class:list={["mx-auto w-full px-4 pt-5 sm:px-6", container]}>
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-zinc-500 dark:text-zinc-400">
          {trail.map((c, i) =>
            i === trail.length - 1
              ? <li aria-current="page" class="truncate text-zinc-700 dark:text-zinc-300">{c.name}</li>
              : <li class="flex items-center gap-1.5"><a href={url(c.path)} class="text-zinc-500 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">{c.name}</a><span aria-hidden="true">/</span></li>,
          )}
        </ol>
      </nav>
    )}

    <main id="main" class:list={["mx-auto w-full flex-1 px-4 pt-6 pb-16 sm:px-6", container]}>
      <slot />
    </main>

    <footer class="border-t border-zinc-200 bg-zinc-50 text-sm dark:border-zinc-800 dark:bg-zinc-900/40">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        <div>
          <p class="font-semibold text-zinc-900 dark:text-zinc-100">{SITE_NAME}</p>
          <p class="mt-2 muted">Open-source exam and quiz tools checked against the same feature list. Every value links to its source.</p>
          {modified && <p class="mt-3 muted">Data last checked <time datetime={modified}>{modified}</time>.</p>}
        </div>
        <div>
          <p class="eyebrow">Platforms</p>
          <ul class="mt-3 space-y-1.5">
            {indexedPlatforms.map((p) => <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={url(`platform/${p}/`)}>{PLATFORM_LABEL[p] ?? p}</a></li>)}
            <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={url("compare/")}>All products</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Comparisons</p>
          <ul class="mt-3 space-y-1.5">
            {pairs.map((c) => <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={url(`compare/${c.pair}/`)}>{nameOf(c.a)} vs {nameOf(c.b)}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Project</p>
          <ul class="mt-3 space-y-1.5">
            <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={url("methodology/")}>Methodology</a></li>
            <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={REPO_URL}>Source on GitHub</a></li>
            <li><a class="text-zinc-600 no-underline hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100" href={`${REPO_URL}/issues/new?template=correction.yml`}>Report a wrong value</a></li>
          </ul>
          <p class="mt-4 text-xs muted">
            Data and text: <a href={`${REPO_URL}/blob/main/LICENSE-DATA`}>CC BY 4.0</a>.
            Code: <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT</a>.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
